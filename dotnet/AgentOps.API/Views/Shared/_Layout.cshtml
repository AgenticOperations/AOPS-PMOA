<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgentOps Governance Platform</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/agentops.css" />
</head>
<body class="bg-dark text-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary">
        <div class="container">
            <a class="navbar-brand fw-bold text-info" asp-controller="OperationsConsole" asp-action="Index">
                🛡️ AgentOps Control Plane
            </a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="OperationsConsole" asp-action="Index">Operations Console</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="PoliciesMvc" asp-action="Index">Governance Policies</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="PoliciesMvc" asp-action="Create">+ New Policy</a>
                    </li>
                </ul>
                <a href="/swagger" class="btn btn-outline-info btn-sm" target="_blank">Swagger API</a>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 bg-black border-top border-secondary text-center text-muted small">
        <div class="container">
            <span>&copy; 2026 AgentOps (AOPS) · Parallel .NET 8 / ASP.NET MVC Clean Architecture · Built for Autonomous Agent Governance</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/governance-dashboard.js"></script>
</body>
</html>
