{
  "name": "agentops-pmoa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Clean PMOA rebuild of agentOps. Old BUILD remains reference-only.",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "./setup.sh",
    "start:local": "./startup.sh --run-only",
    "dev:api": "npm --workspace @agentops-pmoa/api run dev",
    "dev:circle-worker": "npm --workspace @agentops-pmoa/api run dev:circle-worker",
    "dev:web": "npm --workspace @agentops-pmoa/web run dev",
    "dev:mcp": "npm --workspace @agentops-pmoa/mcp run dev",
    "dev:mcp:http": "npm --workspace @agentops-pmoa/mcp run dev:http",
    "dev:fleet-sellers": "node --env-file=apps/api/.env demo/start-fleet-sellers.mjs",
    "start:fleet-sellers": "node demo/start-fleet-sellers.mjs",
    "build:packages": "npm run build --workspace @agentops-pmoa/contracts --workspace @agentops-pmoa/config --workspace @agentops-pmoa/db --workspace @agentops-pmoa/runtime-client",
    "build:apps": "npm run build --workspace @agentops-pmoa/api --workspace @agentops-pmoa/web --workspace @agentops-pmoa/mcp",
    "build": "npm run build:packages && npm run build:apps",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "lint": "npm run build:packages && npm run lint --workspaces --if-present",
    "test:bootstrap": "node --test scripts/*.test.mjs",
    "test": "npm run test:bootstrap && npm run build:packages && npm run test --workspaces --if-present",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "ci": "npm run verify && npm run audit"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.28.2",
    "@esbuild/darwin-x64": "0.28.2",
    "@esbuild/linux-x64": "0.28.2",
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-darwin-x64": "0.35.3",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@next/swc-darwin-arm64": "15.5.23",
    "@next/swc-darwin-x64": "15.5.23",
    "@next/swc-linux-x64-gnu": "15.5.23",
    "@next/swc-linux-x64-musl": "15.5.23",
    "@open-wallet-standard/core-darwin-arm64": "1.4.2",
    "@open-wallet-standard/core-darwin-x64": "1.4.2",
    "@open-wallet-standard/core-linux-x64-gnu": "1.4.2",
    "@rolldown/binding-darwin-arm64": "1.2.4",
    "@rolldown/binding-darwin-x64": "1.2.4",
    "@rolldown/binding-linux-x64-gnu": "1.2.4",
    "@rolldown/binding-linux-x64-musl": "1.2.4",
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-darwin-x64": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "@unrs/resolver-binding-darwin-arm64": "1.12.2",
    "@unrs/resolver-binding-darwin-x64": "1.12.2",
    "@unrs/resolver-binding-linux-x64-gnu": "1.12.2",
    "@unrs/resolver-binding-linux-x64-musl": "1.12.2",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-darwin-x64": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-x64-musl": "1.33.0"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "testcontainers": "12.0.0",
    "undici": "7.29.0",
    "@circle-fin/cli@0.0.6": {
      "viem": {
        "ws": "8.21.0"
      }
    },
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "hono": "4.13.1",
    "@hono/node-server": "2.1.0"
  }
}
