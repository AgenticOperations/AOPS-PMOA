# AgentOps testnet deployment values for deploy/docker-compose.testnet.yml.
# Copy to a secret-managed deployment environment. Never commit populated values.

# Public origins. All three must be HTTPS in a production deployment.
APP_BASE_URL=https://console.example.com
PUBLIC_API_BASE_URL=https://api.example.com
GOOGLE_OAUTH_REDIRECT_URL=https://console.example.com/api/auth/google/callback
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_ORIGINS=https://console.example.com

# Human authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_COOKIE_NAME=agentops_session

# Private data services. Use a generated password, not this blank template value.
POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=

# Circle worker boundary. Both secrets must be generated and injected by the
# deployment secret manager; the profile key is canonical base64 for 32 bytes.
CIRCLE_TREASURY_PROVIDER=agent_stack
CIRCLE_PROFILE_MASTER_KEY=
CIRCLE_WORKER_TOKEN=
CIRCLE_WORKER_TIMEOUT_MS=10000
CIRCLE_CLI_TIMEOUT_MS=240000
CIRCLE_CLI_MAX_RETRIES=3
CIRCLE_CLI_RETRY_DELAY_MS=5000
CIRCLE_LIQUIDITY_WORKER_POLL_MS=5000
CIRCLE_LIQUIDITY_SUBMITTED_RETRY_MS=30000

# API-only key encrypting stored paid-response material. Generate a distinct
# canonical-base64 32-byte value; never reuse the Circle profile master key.
X402_RESULT_ENCRYPTION_KEY=

# Hosted MCP limits.
AGENTOPS_MCP_TIMEOUT_MS=10000
MCP_MAX_BODY_BYTES=1048576
MCP_MAX_IN_FLIGHT=100
MCP_SHUTDOWN_GRACE_MS=10000

# QA merchants are disabled in a deployed product. Enable only in an isolated
# test environment with PUBLIC_API_BASE_URL on the explicit QA allowlist.
ENABLE_TESTNET_X402_FIXTURES=false

# Phase 3 open cold agent register (disabled by default). When enabled, agents
# may POST /v1/agent-join/open without an invite — payment access stays off.
# AGENT_OPEN_JOIN_ENABLED=true
# AGENT_OPEN_JOIN_ORG_ID=org_...
# AGENT_OPEN_JOIN_MAX_PER_HOUR=5
# AGENT_OPEN_JOIN_MAX_PER_DAY=50
