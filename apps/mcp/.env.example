# Local stdio MCP client configuration
AGENTOPS_API_BASE_URL=http://localhost:8080
AGENTOPS_MCP_CREDENTIAL=copy_agent_runtime_credential_here
AGENTOPS_MCP_TIMEOUT_MS=10000

# Hosted Streamable HTTP MCP service configuration
# The hosted process never loads or uses AGENTOPS_MCP_CREDENTIAL.
AGENTOPS_API_BASE_URL=http://localhost:8080
MCP_HOST=127.0.0.1
MCP_PORT=8070
MCP_PUBLIC_URL=http://127.0.0.1:8070/mcp
MCP_ALLOWED_HOSTS=127.0.0.1:8070,localhost:8070
MCP_ALLOWED_ORIGINS=http://localhost:3005
AGENTOPS_MCP_TIMEOUT_MS=10000
MCP_MAX_BODY_BYTES=1048576
MCP_MAX_IN_FLIGHT=100
MCP_SHUTDOWN_GRACE_MS=10000
