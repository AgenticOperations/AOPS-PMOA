# agentOps console --- environment template. Copy to .env.local (gitignored).
# Deployed consoles require both AGENTOPS_API_BASE_URL and MCP_PUBLIC_URL. Local development may omit
# MCP_PUBLIC_URL and use the safe http://127.0.0.1:8070/mcp default. Human auth still uses the
# backend session cookie relayed by the server-only BFF; no static console key is required.

# Backend (server) base URL --- the agentOps service. Server-only.
# Use 127.0.0.1 locally, not localhost: the API binds IPv4 only, while localhost can
# resolve to ::1 first, which makes server-side fetches fail intermittently.
AGENTOPS_API_BASE_URL=http://127.0.0.1:8080

# Hosted MCP endpoint shown in one-time credential setup / Connections UI.
# Required in production (HTTPS, exact /mcp path).
# Railway production:
MCP_PUBLIC_URL=https://agentops-pmoamcp-production.up.railway.app/mcp
# Local MCP process instead:
# MCP_PUBLIC_URL=http://127.0.0.1:8070/mcp

# Environment label shown in the top-bar badge (the honest live/local mode is appended automatically).
ARC_ENV_LABEL=Arc testnet

# Backend session cookie name --- the BFF reads it from the browser and forwards it upstream.
# Must match the backend's SESSION_COOKIE_NAME. Server-only.
SESSION_COOKIE_NAME=agentops_session

# This app's own origin (used as the OAuth landing + redirect base). Server-only.
APP_BASE_URL=http://localhost:3005
