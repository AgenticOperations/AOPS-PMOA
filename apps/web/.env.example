# agentOps console --- environment template. Copy to .env.local (gitignored).
# The product surface authenticates HUMANS via the backend session cookie (the server-only BFF relays
# it); no static key is needed to run the console. Only AGENTOPS_API_BASE_URL is required.

# Backend (server) base URL --- the agentOps service. Server-only.
AGENTOPS_API_BASE_URL=http://localhost:8080

# Hosted MCP endpoint shown in one-time credential setup. Required in production deployments and
# must be HTTPS with the exact /mcp path. Server-side public configuration.
MCP_PUBLIC_URL=http://localhost:8070/mcp

# Environment label shown in the top-bar badge (the honest live/local mode is appended automatically).
ARC_ENV_LABEL=Arc testnet

# Backend session cookie name --- the BFF reads it from the browser and forwards it upstream.
# Must match the backend's SESSION_COOKIE_NAME. Server-only.
SESSION_COOKIE_NAME=agentops_session

# This app's own origin (used as the OAuth landing + redirect base). Server-only.
APP_BASE_URL=http://localhost:3005
