{
  "name": "@agentops-pmoa/api",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "node --env-file=.env ../../node_modules/.bin/tsx watch src/server.ts",
    "dev:circle-worker": "node --env-file=.env ../../node_modules/.bin/tsx watch src/circle-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:circle-worker": "node dist/src/circle-worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentops-pmoa/config": "0.0.0",
    "@agentops-pmoa/contracts": "0.0.0",
    "@agentops-pmoa/db": "0.0.0",
    "@circle-fin/cli": "0.0.6",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/x402-batching": "^3.2.0",
    "@x402/evm": "^2.17.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "viem": "^2.54.6",
    "ws": "8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.4",
    "testcontainers": "12.1.0",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.9"
  }
}
