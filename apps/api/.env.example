# agentOps server --- environment template. Copy to .env (gitignored). NEVER commit real secrets.
# Everything below boots the current local testnet stack. Organization Circle credentials are
# connected through the product UI and stored encrypted by the private worker.

# ------ Runtime ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# ------ Postgres (cold tier: control, ledger-cold, identity) ---------------------------------------------------------------------
DATABASE_URL=postgres://agentops:agentops@localhost:5432/agentops

# ------ Redis (hot tier: enforcement, ledger-hot --- AOF-durable per NFR-02) ---------------------------
REDIS_URL=redis://localhost:6379

# ------ Identity / Auth (human self-serve: Google OAuth sessions) ------
# The frontend BFF relays this session cookie; the backend is the source of truth on validity/expiry.
SESSION_COOKIE_NAME=agentops_session
# Where OAuth lands the browser after the dance (the frontend origin).
APP_BASE_URL=http://localhost:3005
# Canonical externally reachable API origin. Local QA may use loopback; production requires HTTPS.
PUBLIC_API_BASE_URL=http://localhost:8080
# Google OAuth. The redirect URL MUST point at the frontend BFF callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3005/api/auth/google/callback

# ------ Circle provider boundary ------------------------------------------------
# Default: organization-scoped Circle Agent Wallet sessions connected through the product UI.
CIRCLE_TREASURY_PROVIDER=agent_stack
CIRCLE_API_BASE=https://api.circle.com
# Optional fallback values used only when CIRCLE_TREASURY_PROVIDER=developer_controlled.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_TEST_API_KEY=
CIRCLE_TEST_ENTITY_SECRET=
# Worker-only: base64-encoded 32-byte key used to encrypt organization-scoped Circle CLI profiles.
# Generate once per deployment and store it in the deployment secret manager. Do not expose it to web.
CIRCLE_PROFILE_MASTER_KEY=
# Private internal worker endpoint and a random token of at least 32 characters.
CIRCLE_WORKER_URL=http://127.0.0.1:8090
CIRCLE_WORKER_TOKEN=
CIRCLE_WORKER_HOST=127.0.0.1
CIRCLE_WORKER_PORT=8090
# Bounded private API-to-worker request timeout.
CIRCLE_WORKER_TIMEOUT_MS=10000
# Optional provider tuning. Defaults are defined in code.
CIRCLE_CLI_TIMEOUT_MS=240000
CIRCLE_CLI_MAX_RETRIES=3
CIRCLE_CLI_RETRY_DELAY_MS=5000
CIRCLE_LIQUIDITY_WORKER_POLL_MS=5000
CIRCLE_LIQUIDITY_SUBMITTED_RETRY_MS=30000

# API-only, canonical-base64 32-byte key for encrypted durable paid-response material.
# Generate a distinct key; never reuse CIRCLE_PROFILE_MASTER_KEY.
X402_RESULT_ENCRYPTION_KEY=

# Isolated QA only. Keep false for the deployed product.
ENABLE_TESTNET_X402_FIXTURES=false
