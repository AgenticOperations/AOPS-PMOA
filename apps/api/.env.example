# agentOps server --- environment template. Copy to .env (gitignored). NEVER commit real secrets.
# Everything below boots a fully-functional LOCAL stack with safe defaults. The credential-gated
# integrations (Google, Circle, live Arc, AWS KMS) run in a clearly-labeled local mode until you supply
# real values --- see _handoff/CREDENTIALS-NEEDED.md. Load before running: `set -a; . ./.env; set +a`.

# ------ Runtime ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# ------ Postgres (cold tier: control, ledger-cold, identity) ---------------------------------------------------------------------
DATABASE_URL=postgres://agentops:agentops@localhost:5432/agentops

# ------ Redis (hot tier: enforcement, ledger-hot --- AOF-durable per NFR-02) ---------------------------
REDIS_URL=redis://localhost:6379

# ------ Identity / Auth (human self-serve: Google OAuth sessions) ------
# The frontend BFF relays this session cookie; the backend is the source of truth on validity/expiry.
SESSION_COOKIE_NAME=agentops_session
# Set only for a shared parent domain in production (e.g. .example.com) so app + api share the cookie.
COOKIE_DOMAIN=
# Where OAuth lands the browser after the dance (the frontend origin).
APP_BASE_URL=http://localhost:3005
# Per-IP fixed-window auth throttle (login/register/reset). Fail-open if Redis is down.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
# Google OAuth (credential-gated --- 501 until all three are set). The redirect URL MUST point at the
# FRONTEND BFF callback. See _handoff/CREDENTIALS-NEEDED.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3005/api/auth/google/callback

# ------ Chain RPC (Arc testnet is the live rail; Solana is designed-for) ---------------------------------
# Arc Testnet: chainId 5042002, domainId 26
ARC_RPC_URL=https://rpc.arc-testnet.example
ARC_CHAIN_ID=5042002
# USDC on Arc testnet
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Flip to true (WITH a real, reachable ARC_RPC_URL) to read the EIP-712 domain live on-chain.
# false (default) uses the known-correct USDC v2 constant (labeled local in /v1/integrations/status).
ARC_LIVE=false
# Circle Gateway (Arc testnet)
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
GATEWAY_MINTER_ADDRESS=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B
# Solana (designed-for seam; unset in Phase-1 live)
SOLANA_RPC_URL=

# ------ Custody / KMS (distinct roles: treasury-allocation vs agent-float) ---------------------------
# Phase-1 uses a local dev signer; both keys default to public ANVIL test keys (NEVER fund these).
# Set real funded keys (or AWS KMS ids + KMS_PROVIDER=aws) for true on-chain settlement.
KMS_PROVIDER=local
KMS_TREASURY_KEY_ID=
KMS_AGENT_FLOAT_KEY_ID=
# TREASURY_PRIVATE_KEY=0x...     (defaults to an anvil test key locally)
# AGENT_FLOAT_PRIVATE_KEY=0x...  (defaults to an anvil test key locally)

# ------ Circle API (real Gateway transport requires CIRCLE_GATEWAY_LIVE=true AND a key; else labeled stub) ------
CIRCLE_API_BASE=https://api.circle.com
CIRCLE_API_KEY=
# Worker-only: base64-encoded 32-byte key used to encrypt organization-scoped Circle CLI profiles.
# Generate once per deployment and store it in the deployment secret manager. Do not expose it to web.
CIRCLE_PROFILE_MASTER_KEY=
# Private internal worker endpoint and a random token of at least 32 characters.
CIRCLE_WORKER_URL=http://127.0.0.1:8090
CIRCLE_WORKER_TOKEN=
CIRCLE_WORKER_HOST=127.0.0.1
CIRCLE_WORKER_PORT=8090
# Explicit opt-in for the real Gateway transport. Leave false until the on-chain Gateway protocol
# (deposit/attestation/mint) is integrated --- a key alone must not route treasury through Gateway.
CIRCLE_GATEWAY_LIVE=false

# ------ Email delivery (verify / reset / invitation) ---------------------------------------------------------------------------------------------
# All set (host+user+pass) --- real SMTP transport (live). Any missing --- labeled dev-log transport that
# logs the link locally (local). Mode is surfaced at GET /v1/integrations/status. The pass is never logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From header (defaults to SMTP_USER when blank), e.g. "agentOps <no-reply@agentops.dev>"
EMAIL_FROM=

# ------ Killer-cell demo (the ONE intentional demo; env-gated, never registered in prod) ------
DEMO_ENABLED=false
DEMO_VENDOR_HOST=vendor.demo.agentops.local
DEMO_VENDOR_ADDRESS=0x000000000000000000000000000000000000dEaD
DEMO_RESOURCE=/v1/demo/quote
